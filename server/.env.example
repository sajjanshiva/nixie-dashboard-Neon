# Copy this file to .env and fill in real values.

PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- Neon (Postgres) ---
# From Neon's "Connect" modal. DATABASE_URL = pooled (has "-pooler" in
# the hostname), used by the app at runtime. DIRECT_URL = non-pooled,
# used for running schema/migrations only.
DATABASE_URL=postgresql://neondb_owner:npg_RgqD5L6KEAvM@ep-silent-sunset-b3722ojy-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://neondb_owner:npg_RgqD5L6KEAvM@ep-silent-sunset-b3722ojy.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Auth (replaces Supabase Auth) ---
JWT_SECRET=60b33969bed7fb842ba706006f1ab21bcd3b14ece30fe75db3b556a73733e203cc141e037783e98f73b53decd21446f3

# --- Invite emails (SMTP — e.g. Gmail App Password, not your real password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- First admin account (created once, on `npm run seed:admin`) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Web Push (browser/OS notifications) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret for the (now-unused, safe to ignore) /webhooks/push/notify
# route — kept in case you still want an external trigger path later.
PUSH_WEBHOOK_SECRET=

# --- ImageKit (receipt uploads) ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Shopify ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v19.0

# NOTE: office geofence (lat/lng/radius) and office start/end time are
# NOT env vars — they live in the `settings` table in the database and
# are edited from the app's Settings page (admin). OFFICE_LAT/LNG/etc.
# above were listed in the old .env.example but were never actually read
# by the code that way — a pre-existing doc/code mismatch, unrelated to
# the migration, removed here rather than carried forward incorrectly.
