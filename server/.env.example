# =============================================================================
# Nixie Dashboard Server — Environment Variables (.env)
# Copy this file to .env and fill in real production values.
# Legend:
#   [SET BY DEVELOPER]  — you generate/decide this yourself
#   [ASK NIXIE TEAM]    — you must get this value from the client (Team Nixie)
# =============================================================================


# --- Server & Client Origins ---

# PORT: Port the server listens on locally
# [SET BY DEVELOPER] — use 5001 locally; hosting platforms (Render etc.) set this automatically
PORT=5001

# CLIENT_ORIGIN: The frontend URL allowed to call this server (CORS)
# [SET BY DEVELOPER] — local: http://localhost:5173 | production: your deployed frontend URL
CLIENT_ORIGIN=http://localhost:5173


# --- Neon (Postgres Database) ---

# DATABASE_URL: Pooled connection string (host contains "-pooler"), used at runtime
# [ASK NIXIE TEAM] — from Neon Console -> their project -> Connect
DATABASE_URL=postgresql://user:password@ep-pooler.region.aws.neon.tech/neondb?sslmode=require

# DIRECT_URL: Direct non-pooled connection string, used only for running schema/migrations
# [ASK NIXIE TEAM] — from same Neon Console Connect screen (non-pooler URL)
DIRECT_URL=postgresql://user:password@ep.region.aws.neon.tech/neondb?sslmode=require


# --- Authentication ---

# JWT_SECRET: Random 64-character string used to sign and verify user login tokens
# [SET BY DEVELOPER] — generate once: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=your_long_random_jwt_secret_here


# --- First Admin Seed Account ---
# Used once only by `npm run seed:admin` to create the first admin login

# [ASK NIXIE TEAM] — name and email of the admin account they want created
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@nixie.in

# [SET BY DEVELOPER] — set a strong initial password; admin should change it after first login
ADMIN_PASSWORD=change_this_password


# --- Brevo (Transactional Emails — invite links, password resets) ---

# BREVO_API_KEY: API key from Brevo account
# [ASK NIXIE TEAM] — from brevo.com -> Account -> SMTP & API -> API Keys
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# BREVO_SENDER_EMAIL: Verified sender email address in Brevo
# [ASK NIXIE TEAM] — the verified business email they want emails sent from (e.g. support@nixie.in)
BREVO_SENDER_EMAIL=support@nixie.in

# BREVO_SENDER_NAME: Display name shown in sent emails
# [ASK NIXIE TEAM] — usually their brand name
BREVO_SENDER_NAME=Nixie Dashboard


# --- ImageKit (Receipt & Outfit Image Uploads) ---

# [ASK NIXIE TEAM] — from imagekit.io -> Dashboard -> Developer options -> API keys
IMAGEKIT_PUBLIC_KEY=public_your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint_id


# --- Shopify Store Integration ---

# SHOPIFY_STORE_DOMAIN: Their Shopify store domain
# [ASK NIXIE TEAM] — e.g. storename.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# SHOPIFY_CLIENT_ID & SHOPIFY_CLIENT_SECRET:
# [ASK NIXIE TEAM] — from Shopify Admin -> Settings -> Apps -> Develop apps -> their custom app
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=shpss_your_shopify_client_secret

# SHOPIFY_API_VERSION: Shopify API version in use
# [SET BY DEVELOPER] — update only if a newer version is required
SHOPIFY_API_VERSION=2026-07

# SHOPIFY_WEBHOOK_SECRET: Secret Shopify signs webhook payloads with (used to verify real requests)
# [ASK NIXIE TEAM] — from Shopify Admin -> Settings -> Notifications -> scroll to bottom Webhooks section -> copy secret key
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_signing_secret


# --- WhatsApp Business Cloud API (Meta) ---

# WHATSAPP_PHONE_NUMBER_ID: ID of their registered WhatsApp Business phone number
# [ASK NIXIE TEAM] — from developers.facebook.com -> their app -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# WHATSAPP_ACCESS_TOKEN: Permanent System User Access Token
# [ASK NIXIE TEAM] — from Meta Business Settings -> System Users -> generate token
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token

# WHATSAPP_API_VERSION: Meta Graph API version
# [SET BY DEVELOPER] — update only when Meta deprecates current version
WHATSAPP_API_VERSION=v19.0

# WHATSAPP_VERIFY_TOKEN: Custom secret string entered in Meta Webhook configuration to prove ownership
# [SET BY DEVELOPER] — you choose any secret string; enter the same string in Meta webhook settings
WHATSAPP_VERIFY_TOKEN=nixie_dashboard_verify_2026

# WHATSAPP_DEFAULT_COUNTRY_CODE: Prepended to phone numbers that don't already have a country code
# [SET BY DEVELOPER] — 91 for India
WHATSAPP_DEFAULT_COUNTRY_CODE=91


# --- Web Push (Browser/Mobile Notifications) ---

# VAPID keys are a public/private key pair that allow your server to send push notifications
# [SET BY DEVELOPER] — generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# VAPID_SUBJECT: Contact email sent to browser push services for identification
# [SET BY DEVELOPER] — use the admin/developer email
VAPID_SUBJECT=mailto:admin@nixie.in

# PUSH_WEBHOOK_SECRET: Optional secret for external push trigger endpoint
# [SET BY DEVELOPER] — pick any random string
PUSH_WEBHOOK_SECRET=your_push_webhook_secret_here


# --- Office Attendance Geofence ---
# These are fallback defaults only — they can be overridden anytime from the Admin Settings UI

# [ASK NIXIE TEAM] — their real office GPS coordinates and working hours
OFFICE_LAT=13.0306
OFFICE_LNG=77.5525
OFFICE_RADIUS_METERS=150
OFFICE_START_TIME=09:30
