# =============================================================================
# Nixie Dashboard Client — Environment Variables (.env)
# Copy this file to .env and fill in real values.
# Note: All VITE_* variables are embedded in the frontend bundle at build time.
# Legend:
#   [SET BY DEVELOPER]  — you generate/decide this yourself
#   [ASK NIXIE TEAM]    — you must get this value from the client (Team Nixie)
# =============================================================================


# --- Backend API URL ---
# Public URL of your hosted backend server (e.g. Render, Railway, or custom domain)
# [SET BY DEVELOPER] — local: http://localhost:5001 | production: your deployed backend URL
VITE_API_BASE_URL=http://localhost:5001


# --- ImageKit (Receipt & Outfit Image Uploads) ---
# Must match the server's IMAGEKIT_URL_ENDPOINT and IMAGEKIT_PUBLIC_KEY exactly
# [ASK NIXIE TEAM] — from imagekit.io -> Dashboard -> Developer options -> API keys
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint_id
VITE_IMAGEKIT_PUBLIC_KEY=public_your_imagekit_public_key


# --- Web Push (Browser Notifications) ---
# Must be the SAME value as the server's VAPID_PUBLIC_KEY (they are generated as a pair)
# [SET BY DEVELOPER] — copy the public key from: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
